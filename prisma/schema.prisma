model FileFolder {
  id              String          @id @default(cuid())
  name            String          @db.VarChar(120)
  parentId        String?
  category        String?         @db.VarChar(64)
  tagText         String?         @db.Text
  permissionScope String?         @db.VarChar(128)
  note            String?         @db.Text
  createdByUserId String
  dataScope       RecordDataScope @default(REAL)
  partitionKey    String          @default("REAL") @db.VarChar(64)
  testBatchId     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  parent    FileFolder?  @relation("FileFolderTree", fields: [parentId], references: [id])
  children  FileFolder[] @relation("FileFolderTree")
  createdBy User         @relation(fields: [createdByUserId], references: [id])
  testBatch TestBatch?   @relation(fields: [testBatchId], references: [id])
  files     FileRecord[]

  @@unique([parentId, name, partitionKey])
  @@index([parentId])
  @@index([updatedAt])
  @@index([createdByUserId])
  @@index([partitionKey])
  @@index([testBatchId])
}

model FileRecord {
  id              String           @id @default(cuid())
  fileName        String
  fileUrl         String           @db.VarChar(500)
  fileType        String?          @db.VarChar(64)
  fileSizeBytes   Int?
  category        String?          @db.VarChar(64)
  tagText         String?          @db.Text
  note            String?          @db.Text
  businessType    String?          @db.VarChar(64)
  businessId      String?          @db.VarChar(128)
  relatedType     String?          @db.VarChar(64)
  relatedId       String?          @db.VarChar(128)
  folderId        String?
  status          FileRecordStatus @default(ACTIVE)
  isImportant     Boolean          @default(false)
  isArchived      Boolean          @default(false)
  permissionScope String?          @db.VarChar(128)
  versionGroupId  String?          @db.VarChar(191)
  versionNumber   Int              @default(1)
  versionNote     String?          @db.Text
  deletedAt       DateTime?
  deletedByUserId String?          @db.VarChar(191)
  deletedReason   String?          @db.VarChar(255)
  uploaderUserId  String
  dataScope       RecordDataScope  @default(REAL)
  partitionKey    String           @default("REAL") @db.VarChar(64)
  testBatchId     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  folder    FileFolder? @relation(fields: [folderId], references: [id])
  deletedBy User?       @relation("FileRecordDeletedBy", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  uploader  User        @relation(fields: [uploaderUserId], references: [id])
  testBatch TestBatch?  @relation(fields: [testBatchId], references: [id])

  @@index([folderId])
  @@index([uploaderUserId])
  @@index([businessType, businessId])
  @@index([relatedType, relatedId])
  @@index([category])
  @@index([status])
  @@index([isImportant])
  @@index([isArchived])
  @@index([versionGroupId])
  @@index([deletedAt])
  @@index([deletedByUserId])
  @@index([createdAt])
  @@index([partitionKey])
  @@index([testBatchId])
}

