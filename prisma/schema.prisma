generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum DataScope {
  ALL
  DEPARTMENT
  TEAM
  OWNED
  PARTICIPATED
}

enum RecordDataScope {
  REAL
  TEST
}

enum TestBatchStatus {
  ACTIVE
  CLOSED
  CLEARED
}

enum CustomerStatus {
  UNCONTACTED
  CONTACTED
  MET
  COOPERATING
  PAUSED
}

enum ProductStatus {
  ENABLED
  DISABLED
}

enum ProductParseReviewStatus {
  PENDING
  CONFIRMED
  IGNORED
}

enum OutputTemplateType {
  AGRICULTURE_PLAN
  PRODUCT_QUOTE
  SOLUTION_QUOTE
}

enum QuotationType {
  AGRICULTURE
  INDUSTRY
  SERVICE
  BREEDING
  GENERAL
}

enum QuotationStatus {
  DRAFT
  GENERATED
  SENT
  WON
  LOST
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
}

enum PermissionLevel {
  ADMIN_ONLY
  ADMIN_MANAGER
  OWNER_ONLY
  ALL_VISIBLE
}

enum TaskStatus {
  TODO
  DOING
  DONE
  CANCELED
}

enum TaskType {
  FOLLOW_UP
  MEETING
  PLAN
  CONTRACT
  QUOTATION
  OTHER
}

enum InspectionOrderStatus {
  DRAFT
  SAMPLED
  SUBMITTED
  RECEIVED
  IN_PROGRESS
  PARTIAL_REPORTED
  COMPLETED
  ARCHIVED
  CANCELED
}

enum InspectionPaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

enum InspectionItemStatus {
  PENDING
  IN_PROGRESS
  REPORTED
  FAILED
  CANCELED
}

enum WeeklyReportStatus {
  DRAFT
  SUBMITTED
  RETURNED
  APPROVED
}

enum WeeklyPlanReviewStatus {
  PENDING
  COMPLETED
  INCOMPLETE
}

enum RosterWeekStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum RosterPeriodMode {
  WEEK
  MONTH
}

enum WeeklyPayloadMigrationStatus {
  DRY_RUN
  IMPORTED
  SKIPPED
  CONFLICT
  NEEDS_REVIEW
}

enum MonthlyGoalStatus {
  DRAFT
  SUBMITTED
}

enum FileRecordStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  ARCHIVED
  OBSOLETE
}

enum NotificationChannel {
  SYSTEM
  WECOM
  EMAIL
}

enum NotificationSendStatus {
  PENDING
  SENT
  FAILED
}

enum WecomSyncStatus {
  PENDING
  SYNCED
  FAILED
  DELETED
}

enum ApprovalRuleType {
  DISCOUNT
  LOW_PRICE
  EXPORT_QUOTATION
  CUSTOMER_TRANSFER
  CUSTOMER_CLAIM
  CUSTOMER_PROTECTION_EXTENSION
}

enum ApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  IN_FULFILLMENT
  COMPLETED
  CANCELED
}

enum OrderPaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

enum OrderShipmentStatus {
  PENDING
  PARTIAL
  SHIPPED
  DELIVERED
  RETURNED
  CANCELED
}

enum SettlementStatus {
  NOT_REQUIRED
  PENDING
  PARTIAL
  SETTLED
  VOIDED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  WECHAT
  ALIPAY
  OTHER
}

enum PaymentRecordStatus {
  PENDING
  CONFIRMED
  FAILED
  VOIDED
}

enum ShipmentRecordStatus {
  PENDING
  SHIPPED
  DELIVERED
  RETURNED
  CANCELED
}

enum SettlementType {
  DIRECT_SUPPLY
  CHANNEL_RESALE
  CHANNEL_REBATE
  OTHER
}

model User {
  id              String     @id @default(cuid())
  name            String
  loginAccount    String?    @unique @db.VarChar(64)
  mobile          String?    @db.VarChar(32)
  email           String?    @db.VarChar(128)
  passwordHash    String?    @db.VarChar(255)
  wecomUserId     String?    @unique @db.VarChar(128)
  wecomName       String?    @db.VarChar(128)
  wecomAvatar     String?    @db.VarChar(500)
  department      String?    @db.VarChar(128)
  title           String?    @db.VarChar(128)
  managerUserId   String?
  dataScope       DataScope  @default(OWNED)
  note            String?    @db.Text
  status          UserStatus @default(ACTIVE)
  roleId          String
  lastLoginAt     DateTime?
  createdByUserId String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  role                         Role                 @relation(fields: [roleId], references: [id])
  manager                      User?                @relation("UserManager", fields: [managerUserId], references: [id])
  subordinates                 User[]               @relation("UserManager")
  createdByUser                User?                @relation("UserCreator", fields: [createdByUserId], references: [id])
  createdMembers               User[]               @relation("UserCreator")
  customers                    Customer[]           @relation("CustomerOwner")
  followups                    CustomerFollowup[]
  quotations                   Quotation[]
  contracts                    Contract[]
  assignedTasks                Task[]               @relation("TaskAssignee")
  createdTasks                 Task[]               @relation("TaskCreator")
  comments                     TaskComment[]
  discussionComments           DiscussionComment[]
  notifications                Notification[]
  weeklyReports                WeeklyReport[]       @relation("WeeklyReportOwner")
  reviewedWeeklyReports        WeeklyReport[]       @relation("WeeklyReportManagerReviewer")
  publishedWeeklyPublicDigests WeeklyPublicDigest[] @relation("WeeklyPublicDigestPublisher")
  monthlyGoals                 MonthlyGoal[]
  fileFoldersCreated           FileFolder[]
  files                        FileRecord[]
  deletedFiles                 FileRecord[]         @relation("FileRecordDeletedBy")
  productParseLogs             ProductParseLog[]
  reviewedProductParseLogs     ProductParseLog[]    @relation("ProductParseLogReviewer")
  auditLogs                    AuditLog[]
  approvalRulesUpdated         ApprovalRule[]       @relation("ApprovalRuleUpdatedBy")
  systemSettingsUpdated        SystemSetting[]      @relation("SystemSettingUpdatedBy")
  requestedApprovals           ApprovalRequest[]    @relation("ApprovalRequester")
  actingApprovals              ApprovalRequest[]    @relation("ApprovalActor")
  salesOrdersOwned             SalesOrder[]         @relation("SalesOrderOwner")
  salesOrdersCreated           SalesOrder[]         @relation("SalesOrderCreator")
  channelPartnersOwned         ChannelPartner[]     @relation("ChannelPartnerOwner")
  paymentRecordsCreated        PaymentRecord[]      @relation("PaymentRecordCreator")
  shipmentRecordsOperated      ShipmentRecord[]     @relation("ShipmentRecordOperator")
  channelSettlementsCreated    ChannelSettlement[]  @relation("ChannelSettlementCreator")
  createdInspectionOrders      InspectionOrder[]    @relation("InspectionOrderCreator")
  createdTestBatches           TestBatch[]          @relation("TestBatchCreator")
  rosterWeeksActed             RosterWeek[]         @relation("RosterWeekActor")
  rosterShifts                 RosterShift[]        @relation("RosterShiftPerson")
  rosterAuditLogs              RosterAuditLog[]     @relation("RosterAuditActor")
  weeklyReportPayloads         WeeklyReportPayload[] @relation("WeeklyReportPayloadUser")

  @@index([roleId])
  @@index([status])
  @@index([department])
  @@index([managerUserId])
  @@index([dataScope])
  @@index([lastLoginAt])
  @@index([createdByUserId])
}

model Role {
  id               String    @id @default(cuid())
  name             String
  code             String    @unique @db.VarChar(64)
  description      String?   @db.VarChar(255)
  isSystem         Boolean   @default(true)
  defaultDataScope DataScope @default(OWNED)
  sortOrder        Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  users           User[]
  rolePermissions RolePermission[]
}

model TestBatch {
  id              String          @id @default(cuid())
  name            String          @db.VarChar(128)
  code            String          @unique @db.VarChar(64)
  description     String?         @db.Text
  status          TestBatchStatus @default(ACTIVE)
  startedAt       DateTime        @default(now())
  closedAt        DateTime?
  clearedAt       DateTime?
  createdByUserId String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  creator            User                @relation("TestBatchCreator", fields: [createdByUserId], references: [id])
  customers          Customer[]
  quotations         Quotation[]
  agriculturePlans   AgriculturePlan[]
  contracts          Contract[]
  inspectionOrders   InspectionOrder[]
  salesOrders        SalesOrder[]
  paymentRecords     PaymentRecord[]
  shipmentRecords    ShipmentRecord[]
  channelPartners    ChannelPartner[]
  channelSettlements ChannelSettlement[]
  tasks              Task[]
  weeklyReports      WeeklyReport[]
  monthlyGoals       MonthlyGoal[]
  fileFolders        FileFolder[]
  fileRecords        FileRecord[]
  rosterWeeks        RosterWeek[]
  attendancePeriods  AttendancePeriod[]

  @@index([status])
  @@index([createdByUserId])
  @@index([startedAt])
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique @db.VarChar(64)
  name        String
  module      String   @db.VarChar(64)
  category    String   @db.VarChar(32)
  description String?  @db.VarChar(255)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model IndustryGroup {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subgroups  IndustrySubgroup[]
  customers  Customer[]
  products   Product[]
  quotations Quotation[]
}

model IndustrySubgroup {
  id        String   @id @default(cuid())
  groupId   String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group     IndustryGroup @relation(fields: [groupId], references: [id])
  customers Customer[]
  products  Product[]

  @@unique([groupId, name])
  @@index([groupId])
}

model Customer {
  id                    String          @id @default(cuid())
  customerName          String
  companyName           String?         @db.VarChar(255)
  contactName           String?         @db.VarChar(128)
  mobile                String?         @db.VarChar(32)
  wechatId              String?         @db.VarChar(128)
  email                 String?         @db.VarChar(128)
  province              String?         @db.VarChar(64)
  city                  String?         @db.VarChar(64)
  district              String?         @db.VarChar(64)
  address               String?         @db.VarChar(255)
  source                String?         @db.VarChar(128)
  industryGroupId       String?
  industrySubgroupId    String?
  status                CustomerStatus  @default(UNCONTACTED)
  ownerUserId           String
  ownerAssignedAt       DateTime
  ownerProtectionMonths Int             @default(3)
  ownerProtectedUntil   DateTime
  cooperationDirection  String?         @db.Text
  cooperationContent    String?         @db.Text
  estimatedAmount       Decimal?        @db.Decimal(12, 2)
  dealProbability       Int?
  remark                String?         @db.Text
  dataScope             RecordDataScope @default(REAL)
  partitionKey          String          @default("REAL") @db.VarChar(64)
  testBatchId           String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  owner            User               @relation("CustomerOwner", fields: [ownerUserId], references: [id])
  industryGroup    IndustryGroup?     @relation(fields: [industryGroupId], references: [id])
  industrySubgroup IndustrySubgroup?  @relation(fields: [industrySubgroupId], references: [id])
  testBatch        TestBatch?         @relation(fields: [testBatchId], references: [id])
  followups        CustomerFollowup[]
  quotations       Quotation[]
  contracts        Contract[]
  tasks            Task[]
  agriculturePlans AgriculturePlan[]
  salesOrders      SalesOrder[]
  inspectionOrders InspectionOrder[]

  @@index([ownerUserId])
  @@index([ownerProtectedUntil])
  @@index([status])
  @@index([industryGroupId])
  @@index([industrySubgroupId])
  @@index([province, city])
  @@index([partitionKey])
  @@index([testBatchId])
}

model CustomerFollowup {
  id            String    @id @default(cuid())
  customerId    String
  followupDate  DateTime
  followupType  String    @db.VarChar(64)
  content       String    @db.Text
  keyPoints     String?   @db.Text
  nextAction    String?   @db.Text
  nextContactAt DateTime?
  needReminder  Boolean   @default(false)
  creatorUserId String
  createdAt     DateTime  @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
  creator  User     @relation(fields: [creatorUserId], references: [id])

  @@index([customerId])
  @@index([creatorUserId])
  @@index([followupDate])
  @@index([nextContactAt])
}

model Product {
  id                   String             @id @default(cuid())
  name                 String
  displayName          String
  industryGroupId      String?
  industrySubgroupId   String?
  sku                  String?            @db.VarChar(64)
  spec                 String?            @db.VarChar(128)
  unit                 String?            @db.VarChar(32)
  costPrice            Decimal?           @db.Decimal(12, 2)
  salePrice            Decimal?           @db.Decimal(12, 2)
  enterpriseStandardNo String?            @db.VarChar(128)
  intro                String?            @db.Text
  scenarios            String?            @db.Text
  labelText            String?            @db.Text
  labelImageUrl        String?            @db.VarChar(500)
  productImageUrl      String?            @db.VarChar(500)
  quoteEnabled         Boolean            @default(true)
  employeeVisible      Boolean            @default(true)
  customerVisible      Boolean            @default(true)
  outputTemplateType   OutputTemplateType
  remark               String?            @db.Text
  status               ProductStatus      @default(ENABLED)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  industryGroup    IndustryGroup?          @relation(fields: [industryGroupId], references: [id])
  industrySubgroup IndustrySubgroup?       @relation(fields: [industrySubgroupId], references: [id])
  quotationItems   QuotationItem[]
  orderItems       SalesOrderItem[]
  shipmentItems    ShipmentItem[]
  settlementItems  ChannelSettlementItem[]
  inspectionOrders InspectionOrder[]
  reviewedParseLogs ProductParseLog[] @relation("ProductParseLogResolvedProduct")

  @@index([industryGroupId])
  @@index([industrySubgroupId])
  @@index([status])
  @@index([quoteEnabled])
}

model InspectionOrder {
  id                String                  @id @default(cuid())
  inspectionNo      String                  @unique @db.VarChar(64)
  title             String                  @db.VarChar(255)
  customerId        String?
  productId         String?
  projectType       String?                 @db.VarChar(64)
  inspectionTarget  String                  @db.Text
  labName           String                  @db.VarChar(255)
  labCity           String?                 @db.VarChar(64)
  labAddress        String?                 @db.Text
  contactName       String?                 @db.VarChar(128)
  contactPhone      String?                 @db.VarChar(32)
  expectedCycleText String?                 @db.VarChar(128)
  bankInfo          String?                 @db.Text
  summary           String?                 @db.Text
  remark            String?                 @db.Text
  submittedAt       DateTime?
  receivedAt        DateTime?
  status            InspectionOrderStatus   @default(DRAFT)
  paymentStatus     InspectionPaymentStatus @default(UNPAID)
  createdByUserId   String
  dataScope         RecordDataScope         @default(REAL)
  partitionKey      String                  @default("REAL") @db.VarChar(64)
  testBatchId       String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  customer  Customer?            @relation(fields: [customerId], references: [id])
  product   Product?             @relation(fields: [productId], references: [id])
  creator   User                 @relation("InspectionOrderCreator", fields: [createdByUserId], references: [id])
  testBatch TestBatch?           @relation(fields: [testBatchId], references: [id])
  samples   InspectionSample[]
  payments  InspectionPayment[]
  timelines InspectionTimeline[]

  @@index([customerId])
  @@index([productId])
  @@index([createdByUserId])
  @@index([status])
  @@index([paymentStatus])
  @@index([submittedAt])
  @@index([updatedAt])
  @@index([partitionKey])
  @@index([testBatchId])
}

model InspectionSample {
  id                 String    @id @default(cuid())
  orderId            String
  sampleName         String    @db.VarChar(255)
  sampleType         String?   @db.VarChar(64)
  sampleTarget       String?   @db.Text
  sampleQuantityText String?   @db.VarChar(128)
  sampledAt          DateTime?
  submittedAt        DateTime?
  plannedTestScope   String?   @db.Text
  note               String?   @db.Text
  sortOrder          Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  order InspectionOrder        @relation(fields: [orderId], references: [id])
  items InspectionSampleItem[]

  @@index([orderId])
  @@index([sampleType])
  @@index([sampledAt])
}

model InspectionSampleItem {
  id            String               @id @default(cuid())
  sampleId      String
  itemName      String               @db.VarChar(255)
  itemCategory  String?              @db.VarChar(64)
  feeText       String?              @db.VarChar(128)
  feeAmount     Decimal?             @db.Decimal(12, 2)
  status        InspectionItemStatus @default(PENDING)
  resultSummary String?              @db.Text
  progressNote  String?              @db.Text
  completedAt   DateTime?
  sortOrder     Int                  @default(0)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  sample InspectionSample @relation(fields: [sampleId], references: [id])

  @@index([sampleId])
  @@index([itemCategory])
  @@index([status])
  @@index([completedAt])
}

model InspectionPayment {
  id              String    @id @default(cuid())
  orderId         String
  paidAt          DateTime?
  amount          Decimal?  @db.Decimal(12, 2)
  amountText      String?   @db.VarChar(128)
  method          String?   @db.VarChar(64)
  payerName       String?   @db.VarChar(128)
  voucherFileId   String?   @db.VarChar(128)
  invoiceFileId   String?   @db.VarChar(128)
  note            String?   @db.Text
  createdByUserId String
  createdAt       DateTime  @default(now())

  order InspectionOrder @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([paidAt])
  @@index([createdByUserId])
}

model InspectionTimeline {
  id              String    @id @default(cuid())
  orderId         String
  sampleId        String?   @db.VarChar(128)
  itemId          String?   @db.VarChar(128)
  eventType       String    @db.VarChar(64)
  eventAt         DateTime?
  content         String    @db.Text
  createdByUserId String
  createdAt       DateTime  @default(now())

  order InspectionOrder @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([sampleId])
  @@index([itemId])
  @@index([eventType])
  @@index([eventAt])
  @@index([createdByUserId])
}

model Quotation {
  id                    String          @id @default(cuid())
  quotationNo           String          @unique @db.VarChar(64)
  customerId            String
  industryGroupId       String?
  quotationType         QuotationType
  totalOriginalAmount   Decimal         @db.Decimal(12, 2)
  totalDiscountedAmount Decimal         @db.Decimal(12, 2)
  discountType          String?         @db.VarChar(32)
  discountValue         Decimal?        @db.Decimal(12, 2)
  discountReason        String?         @db.Text
  remark                String?         @db.Text
  pdfUrl                String?         @db.VarChar(500)
  shareToken            String?         @unique @db.VarChar(128)
  creatorUserId         String
  approvalStatus        ApprovalStatus  @default(NOT_REQUIRED)
  exportApprovalStatus  ApprovalStatus  @default(NOT_REQUIRED)
  exportedAt            DateTime?
  status                QuotationStatus @default(DRAFT)
  dataScope             RecordDataScope @default(REAL)
  partitionKey          String          @default("REAL") @db.VarChar(64)
  testBatchId           String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  customer         Customer          @relation(fields: [customerId], references: [id])
  industryGroup    IndustryGroup?    @relation(fields: [industryGroupId], references: [id])
  creator          User              @relation(fields: [creatorUserId], references: [id])
  testBatch        TestBatch?        @relation(fields: [testBatchId], references: [id])
  items            QuotationItem[]
  agriculturePlan  AgriculturePlan?
  tasks            Task[]
  approvalRequests ApprovalRequest[]
  salesOrders      SalesOrder[]

  @@index([customerId])
  @@index([creatorUserId])
  @@index([industryGroupId])
  @@index([quotationType])
  @@index([status])
  @@index([createdAt])
  @@index([approvalStatus])
  @@index([exportApprovalStatus])
  @@index([partitionKey])
  @@index([testBatchId])
}

model QuotationItem {
  id               String  @id @default(cuid())
  quotationId      String
  productId        String?
  itemName         String
  quantity         Decimal @db.Decimal(12, 2)
  unitPrice        Decimal @db.Decimal(12, 2)
  originalAmount   Decimal @db.Decimal(12, 2)
  discountedAmount Decimal @db.Decimal(12, 2)
  detailJson       Json?

  quotation Quotation @relation(fields: [quotationId], references: [id])
  product   Product?  @relation(fields: [productId], references: [id])

  @@index([quotationId])
  @@index([productId])
}

model AgriculturePlan {
  id                    String          @id @default(cuid())
  quotationId           String          @unique
  customerId            String
  totalOriginalAmount   Decimal         @db.Decimal(12, 2)
  totalDiscountedAmount Decimal         @db.Decimal(12, 2)
  detailJson            Json
  dataScope             RecordDataScope @default(REAL)
  partitionKey          String          @default("REAL") @db.VarChar(64)
  testBatchId           String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  quotation Quotation  @relation(fields: [quotationId], references: [id])
  customer  Customer   @relation(fields: [customerId], references: [id])
  testBatch TestBatch? @relation(fields: [testBatchId], references: [id])
  tasks     Task[]

  @@index([customerId])
  @@index([partitionKey])
  @@index([testBatchId])
}

model Contract {
  id              String          @id @default(cuid())
  customerId      String
  contractName    String
  contractNo      String?         @db.VarChar(128)
  contractType    String?         @db.VarChar(64)
  signedAt        DateTime?
  effectiveAt     DateTime?
  expiredAt       DateTime?
  amount          Decimal?        @db.Decimal(12, 2)
  status          ContractStatus  @default(DRAFT)
  permissionLevel PermissionLevel
  fileUrl         String?         @db.VarChar(500)
  remark          String?         @db.Text
  creatorUserId   String
  dataScope       RecordDataScope @default(REAL)
  partitionKey    String          @default("REAL") @db.VarChar(64)
  testBatchId     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  customer    Customer     @relation(fields: [customerId], references: [id])
  creator     User         @relation(fields: [creatorUserId], references: [id])
  testBatch   TestBatch?   @relation(fields: [testBatchId], references: [id])
  salesOrders SalesOrder[]

  @@index([customerId])
  @@index([creatorUserId])
  @@index([status])
  @@index([expiredAt])
  @@index([partitionKey])
  @@index([testBatchId])
}

model SalesOrder {
  id                 String              @id @default(cuid())
  orderNo            String              @unique @db.VarChar(64)
  customerId         String
  quotationId        String?
  contractId         String?
  channelPartnerId   String?
  orderDate          DateTime
  orderType          String?             @db.VarChar(32)
  recipientName      String?             @db.VarChar(128)
  recipientPhone     String?             @db.VarChar(32)
  recipientProvince  String?             @db.VarChar(64)
  recipientCity      String?             @db.VarChar(64)
  recipientDistrict  String?             @db.VarChar(64)
  recipientAddress   String?             @db.VarChar(255)
  usagePurpose       String?             @db.Text
  warehouseName      String?             @db.VarChar(128)
  totalProductAmount Decimal?            @db.Decimal(12, 2)
  discountAmount     Decimal?            @db.Decimal(12, 2)
  shippingFee        Decimal?            @db.Decimal(12, 2)
  receivableAmount   Decimal?            @db.Decimal(12, 2)
  receivedAmount     Decimal?            @db.Decimal(12, 2)
  paymentStatus      OrderPaymentStatus  @default(UNPAID)
  shipmentStatus     OrderShipmentStatus @default(PENDING)
  settlementStatus   SettlementStatus    @default(NOT_REQUIRED)
  status             SalesOrderStatus    @default(DRAFT)
