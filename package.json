{
  "name": "huigui-crm-quotation-system",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "db:up": "docker compose up -d mysql",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f mysql",
    "dev": "concurrently \"npm run dev -w @huigui/api\" \"npm run dev -w @huigui/web\"",
    "dev:employee": "npm run dev -w @huigui/employee-frontend",
    "build": "npm run test:payroll && npm run build -w @huigui/api && npm run build -w @huigui/web && npm run build -w @huigui/employee-frontend",
    "build:employee": "npm run build -w @huigui/employee-frontend",
    "lint": "npm run lint -w @huigui/api && npm run lint -w @huigui/web && npm run lint -w @huigui/employee-frontend",
    "lint:employee": "npm run lint -w @huigui/employee-frontend",
    "test:wecom": "tsx tests/wecom-regression.test.ts",
    "test:products": "tsx tests/product-parser-regression.test.ts",
    "test:files": "tsx tests/files-regression.test.ts",
    "test:payroll": "tsx tests/payroll-salary-slip-regression.test.ts",
    "preflight:payroll": "node scripts/migrations/payroll/salary-slip-preflight.mjs",
    "verify:payroll-db": "node scripts/migrations/payroll/salary-slip-db-verify.mjs",
    "fixture:payroll-payload": "node scripts/migrations/payroll/salary-fixture-to-api-payload.mjs",
    "uat:payroll-api": "node scripts/migrations/payroll/salary-api-uat-submit.mjs",
    "audit:payroll-package": "node scripts/migrations/payroll/salary-audit-package.mjs",
    "test:work-management": "tsx tests/work-management-regression.test.ts",
    "test:notifications": "tsx tests/notification-actions-regression.test.ts",
    "deploy:status": "node scripts/ops/show-production-sync-status.mjs",
    "db:generate": "node scripts/with-local-db-env.mjs prisma generate",
    "db:migrate:dev": "node scripts/with-local-db-env.mjs prisma migrate dev",
    "db:migrate:deploy": "node scripts/with-local-db-env.mjs prisma migrate deploy",
    "db:migrate:sql": "node scripts/with-local-db-env.mjs sh -lc \"prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script > prisma/migrations/20260415130000_init/migration.sql\"",
    "db:seed": "node scripts/with-local-db-env.mjs tsx prisma/seed/seed.ts",
    "permissions:sync-solutions": "node scripts/with-local-db-env.mjs node scripts/local/sync-solution-permissions.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.4.2",
    "prisma": "^6.6.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0"
  }
}
